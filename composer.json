{
  "name": "homecare-unai/demo",
  "type": "project",
  "description": "Home Care UNAI - modern booking and operations demo",
  "license": "MIT",
  "require": {"php": "^8.3", "laravel/framework": "^13.17", "laravel/tinker": "^3.0"},
  "require-dev": {"fakerphp/faker":"^1.24", "laravel/pint":"^1.24", "mockery/mockery":"^1.6", "nunomaduro/collision":"^8.6", "phpunit/phpunit":"^12.0"},
  "autoload": {"psr-4": {"App\\":"app/", "Database\\Factories\\":"database/factories/", "Database\\Seeders\\":"database/seeders/"}},
  "autoload-dev": {"psr-4": {"Tests\\":"tests/"}},
  "scripts": {"post-autoload-dump": ["Illuminate\\Foundation\\ComposerScripts::postAutoloadDump", "@php artisan package:discover --ansi"], "post-create-project-cmd": ["@php -r \"file_exists('.env') || copy('.env.example', '.env');\"", "@php artisan key:generate --ansi", "@php artisan migrate --graceful --ansi"], "dev": ["Composer\\Config::disableProcessTimeout", "npx concurrently -c '#10b981,#60a5fa' \"php artisan serve\" \"npm run dev\""]},
  "config": {"optimize-autoloader": true, "preferred-install": "dist", "sort-packages": true},
  "minimum-stability": "stable", "prefer-stable": true
}
